<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jei failas ar katalogas egzistuoja fiziškai - atidaryti jį
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Nukreipti adverts, raw, telemetry į src/app.php
    RewriteRule ^(adverts|raw|telemetry)/?$ src/app.php [L,QSA]
    RewriteRule ^api/(adverts|raw|telemetry)/?$ src/app.php [L,QSA]
</IfModule>
